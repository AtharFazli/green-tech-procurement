<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Create RFP</h1>

  <form id="rfpForm" class="bg-white rounded-lg shadow p-6 space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Title *</label>
      <input type="text" name="title" required minlength="3" class="w-full border rounded px-3 py-2 mt-1">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Description</label>
      <textarea name="description" rows="4" class="w-full border rounded px-3 py-2 mt-1"></textarea>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Deadline *</label>
        <input type="datetime-local" name="deadline" required class="w-full border rounded px-3 py-2 mt-1">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Currency</label>
        <select name="currency" class="w-full border rounded px-3 py-2 mt-1">
          <option value="USD">USD</option>
          <option value="EUR">EUR</option>
          <option value="GBP">GBP</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Budget Min</label>
        <input type="number" step="0.01" name="budget_min" class="w-full border rounded px-3 py-2 mt-1">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Budget Max</label>
        <input type="number" step="0.01" name="budget_max" class="w-full border rounded px-3 py-2 mt-1">
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Sustainability Requirements</label>
      <textarea name="sustainability_requirements" rows="3" class="w-full border rounded px-3 py-2 mt-1"></textarea>
    </div>

    <div class="flex items-center">
      <input type="checkbox" name="is_green_rfp" value="true" class="mr-2">
      <label class="text-sm font-medium text-gray-700">Green RFP</label>
    </div>

    <!-- Line Items -->
    <div>
      <div class="flex justify-between items-center mb-2">
        <h3 class="text-lg font-semibold text-gray-700">Line Items</h3>
        <button type="button" onclick="addLineItem()" class="text-sm bg-gray-100 px-3 py-1 rounded hover:bg-gray-200">+ Add Item</button>
      </div>
      <table class="w-full" id="lineItemsTable">
        <thead>
          <tr class="text-left text-sm text-gray-500">
            <th class="pb-2">Item Name</th>
            <th class="pb-2">Description</th>
            <th class="pb-2">Quantity</th>
            <th class="pb-2">Unit</th>
            <th class="pb-2">Est. Price</th>
            <th class="pb-2"></th>
          </tr>
        </thead>
        <tbody id="lineItemsBody">
          <tr class="line-item">
            <td><input type="text" name="line_items[0][item_name]" required class="w-full border rounded px-2 py-1 text-sm"></td>
            <td><input type="text" name="line_items[0][description]" class="w-full border rounded px-2 py-1 text-sm"></td>
            <td><input type="number" step="0.01" name="line_items[0][quantity]" required class="w-20 border rounded px-2 py-1 text-sm"></td>
            <td><input type="text" name="line_items[0][unit]" required class="w-20 border rounded px-2 py-1 text-sm"></td>
            <td><input type="number" step="0.01" name="line_items[0][estimated_price]" class="w-24 border rounded px-2 py-1 text-sm"></td>
            <td><button type="button" onclick="this.closest('tr').remove()" class="text-red-500 text-sm">Remove</button></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="flex justify-end gap-4 pt-4">
      <a href="/rfps" class="px-4 py-2 border rounded text-gray-700 hover:bg-gray-50">Cancel</a>
      <button type="submit" class="px-4 py-2 bg-emerald-600 text-white rounded hover:bg-emerald-700">Create RFP</button>
    </div>
  </form>
</div>

<script>
let itemIndex = 1;
function addLineItem() {
  const tbody = document.getElementById('lineItemsBody');
  const tr = document.createElement('tr');
  tr.className = 'line-item';
  tr.innerHTML = `
    <td><input type="text" name="line_items[${itemIndex}][item_name]" required class="w-full border rounded px-2 py-1 text-sm"></td>
    <td><input type="text" name="line_items[${itemIndex}][description]" class="w-full border rounded px-2 py-1 text-sm"></td>
    <td><input type="number" step="0.01" name="line_items[${itemIndex}][quantity]" required class="w-20 border rounded px-2 py-1 text-sm"></td>
    <td><input type="text" name="line_items[${itemIndex}][unit]" required class="w-20 border rounded px-2 py-1 text-sm"></td>
    <td><input type="number" step="0.01" name="line_items[${itemIndex}][estimated_price]" class="w-24 border rounded px-2 py-1 text-sm"></td>
    <td><button type="button" onclick="this.closest('tr').remove()" class="text-red-500 text-sm">Remove</button></td>
  `;
  tbody.appendChild(tr);
  itemIndex++;
}

document.getElementById('rfpForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const formData = new FormData(this);
  const lineItems = [];
  const rows = document.querySelectorAll('.line-item');
  rows.forEach(function(row, idx) {
    const inputs = row.querySelectorAll('input');
    const item = {};
    inputs.forEach(function(input) {
      const name = input.getAttribute('name');
      const key = name ? name.match(/\[(\w+)\]/)[1] : '';
      if (key) {
        if (key === 'quantity' || key === 'estimated_price') {
          item[key] = input.value ? parseFloat(input.value) : null;
        } else {
          item[key] = input.value;
        }
      }
    });
    lineItems.push(item);
  });

  const payload = {
    title: formData.get('title'),
    description: formData.get('description'),
    deadline: new Date(formData.get('deadline')).toISOString(),
    budget_min: formData.get('budget_min') ? parseFloat(formData.get('budget_min')) : null,
    budget_max: formData.get('budget_max') ? parseFloat(formData.get('budget_max')) : null,
    currency: formData.get('currency'),
    sustainability_requirements: formData.get('sustainability_requirements'),
    is_green_rfp: formData.get('is_green_rfp') === 'true',
    line_items: lineItems
  };

  try {
    const res = await fetch('/api/v1/rfps', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      window.location.href = '/rfps/' + data.data.id;
    } else {
      alert('Error: ' + (data.message || 'Validation failed'));
    }
  } catch (err) {
    alert('Network error');
  }
});
</script>

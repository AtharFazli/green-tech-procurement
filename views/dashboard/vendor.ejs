<div data-dashboard>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">🌿 My Vendor Dashboard</h1>
    <p class="text-gray-500">Your bidding performance and green metrics</p>
  </div>

  <!-- Stats grid -->
  <div class="stats-grid">
    <div class="dashboard-stat">
      <div class="stat-icon">📋</div>
      <div class="stat-value" id="stat-totalBids">—</div>
      <div class="stat-label">Total Bids</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">🟢</div>
      <div class="stat-value" id="stat-activeBids">—</div>
      <div class="stat-label">Active Bids</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">🏆</div>
      <div class="stat-value" id="stat-wins">—</div>
      <div class="stat-label">Wins</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">📊</div>
      <div class="stat-value" id="stat-winRate">—</div>
      <div class="stat-label">Win Rate (%)</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">💰</div>
      <div class="stat-value" id="stat-totalRevenue">—</div>
      <div class="stat-label">Total Revenue</div>
    </div>
  </div>

  <!-- Green metrics card -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6 border border-gray-100">
    <h2 class="text-lg font-semibold text-gray-700 mb-3">🟢 Green Products</h2>
    <div class="flex flex-wrap gap-6">
      <div>
        <span class="green-badge">🌱 Green: <strong id="green-greenProducts">—</strong> / <strong id="green-totalProducts">—</strong></span>
      </div>
      <div>
        <span class="text-sm text-gray-600">Avg Carbon Footprint: <strong><span id="green-avgCarbon">0</span></strong></span>
      </div>
    </div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-container">
      <h3 class="text-sm font-semibold text-gray-600 mb-2">📈 RFP Trend (12 months)</h3>
      <canvas id="chart-rfp-trend" height="200"></canvas>
    </div>
    <div class="chart-container">
      <h3 class="text-sm font-semibold text-gray-600 mb-2">📌 Recent Activity</h3>
      <div id="activity-feed"></div>
    </div>
  </div>

  <!-- Top vendors -->
  <div class="bg-white rounded-xl shadow-sm p-4 border border-gray-100 mb-6">
    <h3 class="text-sm font-semibold text-gray-600 mb-3">🏆 Top Vendors (Platform)</h3>
    <table id="top-vendors-table" class="w-full text-sm">
      <thead>
        <tr class="text-left text-gray-500 border-b">
          <th class="pb-2">#</th>
          <th class="pb-2">Company</th>
          <th class="pb-2">Wins</th>
          <th class="pb-2">Bids</th>
          <th class="pb-2">Sustain.</th>
          <th class="pb-2">Status</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<% if (typeof scripts === 'undefined') { scripts = ''; } %>
<% scripts += '<script src="/js/dashboard.js"></script>'; %>

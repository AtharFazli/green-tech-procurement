<% body = 'dashboard-buyer' %>
<%- include('../layouts/main', { body: `
<div data-dashboard>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">🌿 Green Procurement Dashboard</h1>
    <p class="text-gray-500">Your procurement overview at a glance</p>
  </div>

  <!-- Stats grid -->
  <div class="stats-grid">
    <div class="dashboard-stat">
      <div class="stat-icon">📋</div>
      <div class="stat-value" id="stat-totalRfps">—</div>
      <div class="stat-label">Total RFPs</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">🟢</div>
      <div class="stat-value" id="stat-activeRfps">—</div>
      <div class="stat-label">Active RFPs</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">✅</div>
      <div class="stat-value" id="stat-completedRfps">—</div>
      <div class="stat-label">Completed RFPs</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">💰</div>
      <div class="stat-value" id="stat-totalBids">—</div>
      <div class="stat-label">Total Bids</div>
    </div>
    <div class="dashboard-stat">
      <div class="stat-icon">📊</div>
      <div class="stat-value" id="stat-avgBidsPerRfp">—</div>
      <div class="stat-label">Avg Bids / RFP</div>
    </div>
  </div>

  <!-- Green metrics card -->
  <div class="bg-white rounded-xl shadow-sm p-5 mb-6 border border-gray-100">
    <h2 class="text-lg font-semibold text-gray-700 mb-3">🟢 Green Metrics</h2>
    <div class="flex flex-wrap gap-6">
      <div>
        <span class="green-badge">🌱 Green RFPs: <strong id="green-greenRfps">—</strong> / <strong id="green-totalRfps">—</strong></span>
      </div>
      <div>
        <span class="green-badge">🏆 Green Awards: <strong id="green-greenAwarded">—</strong></span>
      </div>
      <div>
        <span class="text-sm text-gray-600">Total Spent: <strong>$<span id="stat-totalSpent">0</span></strong></span>
      </div>
    </div>
  </div>

  <!-- Charts grid -->
  <div class="charts-grid">
    <div class="chart-container">
      <h3 class="text-sm font-semibold text-gray-600 mb-2">📈 RFP Trend (12 months)</h3>
      <canvas id="chart-rfp-trend" height="200"></canvas>
    </div>
    <div class="chart-container">
      <h3 class="text-sm font-semibold text-gray-600 mb-2">🍩 RFP Status Breakdown</h3>
      <canvas id="chart-rfp-breakdown" height="200"></canvas>
    </div>
  </div>

  <!-- Budget vs Actual -->
  <div class="chart-container mb-6">
    <h3 class="text-sm font-semibold text-gray-600 mb-2">💰 Budget vs Actual</h3>
    <canvas id="chart-budget-comparison" height="200"></canvas>
  </div>

  <!-- Bottom row: top vendors + activity -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white rounded-xl shadow-sm p-4 border border-gray-100">
      <h3 class="text-sm font-semibold text-gray-600 mb-3">🏆 Top Vendors</h3>
      <table id="top-vendors-table" class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b">
            <th class="pb-2">#</th>
            <th class="pb-2">Company</th>
            <th class="pb-2">Wins</th>
            <th class="pb-2">Bids</th>
            <th class="pb-2">Sustain.</th>
            <th class="pb-2">Status</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-4 border border-gray-100">
      <h3 class="text-sm font-semibold text-gray-600 mb-3">📌 Recent Activity</h3>
      <div id="activity-feed"></div>
    </div>
  </div>
</div>

<script src="/js/dashboard.js"></script>
` }) %>

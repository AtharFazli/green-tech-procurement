<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'GreenTech Procurement' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="/js/chartjs-config.js"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <% if (typeof user !== 'undefined' && user) { %>
  <!-- Navigation for logged-in users -->
  <nav class="bg-emerald-600 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center space-x-8">
          <a href="/dashboard" class="text-xl font-bold">GreenTech Procurement</a>
          <div class="hidden md:flex space-x-4">
            <a href="/dashboard" class="px-3 py-2 rounded hover:bg-emerald-700">Dashboard</a>
            <a href="/rfps" class="px-3 py-2 rounded hover:bg-emerald-700">RFPs</a>
            <a href="/products" class="px-3 py-2 rounded hover:bg-emerald-700">Products</a>
            <a href="/bids" class="px-3 py-2 rounded hover:bg-emerald-700">Bids</a>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <div class="text-sm">
            <span class="block"><%= user.name %></span>
            <span class="block text-emerald-200 text-xs"><%= user.role %></span>
          </div>
          <form action="/logout" method="POST" class="inline">
            <button type="submit" class="px-3 py-1 bg-emerald-700 rounded hover:bg-emerald-800 text-sm">Logout</button>
          </form>
        </div>
      </div>
    </div>
  </nav>
  <% } else { %>
  <!-- Navigation for guests -->
  <nav class="bg-emerald-600 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="text-xl font-bold">GreenTech Procurement</a>
        <div class="flex items-center space-x-4">
          <a href="/login" class="px-3 py-2 rounded hover:bg-emerald-700">Login</a>
          <a href="/register" class="px-3 py-2 bg-white text-emerald-600 rounded hover:bg-gray-100">Register</a>
        </div>
      </div>
    </div>
  </nav>
  <% } %>

  <main class="max-w-7xl mx-auto px-4 py-6">
    <%- body %>
  </main>

  <% if (typeof scripts !== 'undefined') { %>
    <%- scripts %>
  <% } %>
</body>
</html>
